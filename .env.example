# ── WishNest Environment Variables ───────────────────────────────────────────
# Copy to .env for local development. In production, set these in your hosting
# dashboard (Render / DigitalOcean for backend; Vercel for frontend).
# NEVER commit a filled-in .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend (FastAPI on Render / DigitalOcean) ────────────────────────────────

# PostgreSQL — Render / DO managed DB connection string
DATABASE_URL=postgresql://user:password@host:5432/wishnest

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-long-random-secret

# Admin dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# OpenAI (either name is accepted)
OPENAI_API_KEY=sk-...
# CHATGPT_API_KEY=sk-...   # alternative alias

# Firecrawl (web scraping for research pipeline)
FIRECRAWL_API_KEY=fc-...

# CORS — comma-separated origins allowed to call the API
# In production set this to your Vercel frontend domain
CORS_ORIGINS=https://your-app.vercel.app

# App environment
ENVIRONMENT=production


# ── Frontend (Vite on Vercel) ─────────────────────────────────────────────────

# Backend API base URL — set this in Vercel Project Settings → Environment Variables
# Leave empty in local dev (Vite proxy handles /api/* requests)
VITE_API_BASE_URL=https://your-backend.onrender.com

# ── Newsletter (Gmail SMTP — free App Password) ───────────────────────────────
# Google Account → Security → 2-Step Verification ON → App passwords → Mail
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_FROM_NAME=WishNest
PUBLIC_APP_URL=https://wishnest.info

# Preferred on Render (SMTP ports often blocked → Network is unreachable):
# Free: https://resend.com → API Keys → Create
RESEND_API_KEY=re_xxxxxxxx
# After verifying domain wishnest.info:
# RESEND_FROM=WishNest <noreply@wishnest.info>

# Frontend analytics (set on Vercel as env vars, rebuild required)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=1234567890
# VITE_LINKEDIN_PARTNER_ID=xxxxxxx

# WhatsApp Business display number (digits with country code, no +)
# Backend optional: WHATSAPP_BUSINESS_NUMBER=9198XXXXXXXX
# Frontend CTA: set on Vercel
# VITE_WHATSAPP_BUSINESS_NUMBER=9198XXXXXXXX

# Public backend URL (Render). Used so article images store absolute /api/... URLs.
# PUBLIC_API_BASE_URL=https://your-service.onrender.com
# Frontend (Vercel) — also set so browsers resolve /api/image-proxy and /api/reimaging/media
# VITE_API_BASE_URL=https://your-service.onrender.com


# Growth OS — Postiz social (magazine distribution)
# POSTIZ_API_URL=https://your-postiz-host
# POSTIZ_API_KEY=
# AgentReach cold outreach (not Mautic)
# AGENTREACH_API_URL=
# AGENTREACH_API_KEY=

# Mautic (opted-in nurture CRM)
# MAUTIC_BASE_URL=https://your-mautic.example.com
# MAUTIC_USER=
# MAUTIC_PASSWORD=
# MAUTIC_API_TOKEN=


# Postiz (magazine + campaign social)
# POSTIZ_API_URL=https://your-postiz-host
# POSTIZ_API_KEY=
# POSTIZ_POSTS_PATH=/api/public/v1/posts


# Step 8 outreach
# AGENTREACH_API_URL=
# AGENTREACH_API_KEY=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_BASE=https://graph.facebook.com/v18.0
# TELECALLER_API_URL=
# TELECALLER_API_KEY=

# ArrowX handoff
# ARROWX_WEBHOOK_URL=
# ARROWX_WEBHOOK_SECRET=

# Campaign analytics inbound
# CAMPAIGN_WEBHOOK_SECRET=

# Roles: {"admin":"admin","editor1":"editor","sales1":"sales"}
# ADMIN_ROLES=
